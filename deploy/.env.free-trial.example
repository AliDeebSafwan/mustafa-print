# نسخة للتجربة المجانية (خادم Oracle Always Free + نطاقان مجانيان من DuckDNS).
#
# لا تملأ هذا الملف بيدك: شغّل `./make-env.sh` على الخادم، فهو يولّد الأسرار ويكتب deploy/.env
# بصلاحيات لا يقرأها غيرك. هذا الملف هنا لتعرف ما الذي يكتبه ولماذا.
#
# الفروق عن النسخة المدفوعة (deploy/.env.example):
#   - العنوانان نطاقان فرعيان مجانيان بدل نطاق تملكه.
#   - البريد في وضع console: لا يصل شيء إلى الزبائن (التفصيل تحت).
# ما عدا ذلك فالتشغيل واحد، فالانتقال لاحقاً إلى نطاق حقيقي هو تعديل هذه الأسطر وإعادة التشغيل.

# ---- العنوانان: سجّلهما في duckdns.org ووجّههما إلى عنوان IP الخادم قبل التشغيل ----
# عنوانان منفصلان ضرورة لا تفصيل: ملف الدخول للطاقم SameSite=Strict، ولهذا يسكن الـ API تحت عنوان التطبيق.
SITE_DOMAIN=mustafaprint.duckdns.org
APP_DOMAIN=app-mustafaprint.duckdns.org
ACME_EMAIL=                                    # بريدك: تصلك عليه تنبيهات انتهاء الشهادة من Let's Encrypt

# ---- قاعدة البيانات ----
POSTGRES_DB=mustafa
POSTGRES_USER=mustafa
POSTGRES_PASSWORD=                             # يولّده make-env.sh

# ---- الأسرار ----
JWT_ACCESS_SECRET=                             # يولّده make-env.sh
REVALIDATE_SECRET=                             # يولّده make-env.sh

# ---- حساب المدير الأول: للتشغيل الأول فقط ----
# بعد `docker compose run --rm migrate node dist/seed.js` احذف السطرين SEED_ADMIN_EMAIL و SEED_ADMIN_PASSWORD.
# إعادة التشغيل لا تغيّر كلمة سر مدير موجود؛ لتغييرها استعمل:
#   pnpm --filter @mpe/api staff:reset-password <البريد>
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=                           # 12 حرفاً فأكثر
SEED_ADMIN_NAME=Owner
SEED_BRANCH_TIMEZONE=Asia/Beirut

# ---- البريد: في التجربة المجانية لا يصل شيء إلى الزبائن ----
# Resend يرفض الإرسال من نطاق لم توثّقه، وتوثيق نطاق DuckDNS غير ممكن لأن سجلات DNS ليست لك.
# لذلك console: تُطبع رسائل التأكيد واستعادة كلمة السر في سجل الخادم بدل إرسالها:
#     docker compose logs -f api | grep "console provider"
#
# ولتجربة حسابات الزبائن من غير بريد أصلاً: أنشئ الحساب من الموقع، ثم من تطبيق الطاقم
# «حسابات الزبائن على الموقع» ← الحساب ← «الموافقة على الحساب». يصبح قادراً على الطلب فوراً.
#
# تحذير: في وضع الإنتاج يكتب الخادم تحذيراً عند الإقلاع لأن روابط الدخول لمرة واحدة تظهر في السجل.
# هذا مقبول في تجربة بلا زبائن حقيقيين، وغير مقبول بعدها.
#
# عند شراء نطاق حقيقي: وثّقه في Resend، ثم بدّل الأسطر الثلاثة وأعد التشغيل.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# ---- فحص الفيروسات للملفات المرفوعة (اختياري) ----
# يحتاج نحو 1.5 غيغابايت ذاكرة، والخادم المجاني عنده 24، فبإمكانك تشغيله.
# اتركه مطفأً حتى ينجح الإقلاع الأول، ثم شغّله بوضع: COMPOSE_PROFILES=scan و CLAMAV_HOST=clamav
COMPOSE_PROFILES=
CLAMAV_HOST=

# ---- واتساب: يحتاج موافقة Meta ونطاقاً حقيقياً، فهو مؤجّل ----
WHATSAPP_PROVIDER=console

# ---- نفق Cloudflare (فقط عند استعمال compose.tunnel.yaml على جهاز بلا عنوان IP عام) ----
# الرمز من لوحة Cloudflare ← Zero Trust ← Networks ← Tunnels. سرّ يفتح نفقاً إلى شبكتك: لا ترسله إلى أحد.
CLOUDFLARE_TUNNEL_TOKEN=
