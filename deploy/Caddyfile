# Two addresses, one server. Caddy obtains and renews the HTTPS certificates by itself.
#   SITE_DOMAIN : the customer website (e.g. almustafa-print.com)
#   APP_DOMAIN  : the staff app and its API (e.g. app.almustafa-print.com)
# The API lives under the staff app's own domain on purpose: the sign-in cookie is SameSite=Strict.
#
# CADDY_SCHEME is empty on a server of your own: Caddy answers on 443 and gets the certificates itself.
# Behind a Cloudflare tunnel (compose.tunnel.yaml) it is "http://", so Caddy serves plain HTTP on port 80 and asks
# for no certificate: the certificate is Cloudflare's, and this machine is never reachable from the internet.
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$CADDY_SCHEME:}{$SITE_DOMAIN} {
	import common
	# Visitors reach the shop's pictures and order tracking through the website's own address.
	handle /api/v1/public/* {
		reverse_proxy api:4000
	}
	# Only the API may ask the website to refresh; it does so over the internal network, never from outside.
	handle /api/revalidate {
		respond 404
	}
	handle {
		reverse_proxy web:3000
	}
}

{$CADDY_SCHEME:}www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$CADDY_SCHEME:}{$APP_DOMAIN} {
	import common
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /webhooks/* {
		reverse_proxy api:4000
	}
	handle {
		root * /srv/admin
		# The staff app holds orders, customers and money, so it gets the strictest policy. Everything it loads comes
		# from this same address (scripts, styles, the API under /api/*), so 'self' is enough. Inline styles stay
		# allowed because React sets style attributes; no inline script is needed (the theme starts from
		# /theme-boot.js). Never framed by another site (clickjacking), and the camera only for its own scanner.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
			X-Frame-Options DENY
			Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		}
		# Built files carry their hash in the name: cache them forever. The service worker must always be fresh,
		# or staff would stay on an old version of the app.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@worker path /sw.js /registerSW.js /manifest.webmanifest
		header @worker Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
