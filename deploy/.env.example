# Copy to deploy/.env and fill in. Never commit the real file.

# ---- addresses (point both DNS names at this server first) ----
SITE_DOMAIN=almustafa-print.com
APP_DOMAIN=app.almustafa-print.com
ACME_EMAIL=owner@almustafa-print.com          # certificate expiry notices go here

# ---- database ----
POSTGRES_DB=mustafa
POSTGRES_USER=mustafa
POSTGRES_PASSWORD=                             # openssl rand -base64 32

# ---- secrets (each: openssl rand -base64 48) ----
JWT_ACCESS_SECRET=
REVALIDATE_SECRET=

# ---- first start only: the owner's account (then remove these two lines) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Owner
SEED_BRANCH_TIMEZONE=Asia/Beirut

# ---- email: REQUIRED before customers can open accounts on the website ----
# Without it, confirmation and password-reset links are not delivered, and they would appear in the logs.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Mustafa Print <no-reply@almustafa-print.com>   # a sender on a domain verified in Resend

# ---- messages (optional until WhatsApp is approved; see README) ----
WHATSAPP_PROVIDER=console
