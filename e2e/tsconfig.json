{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "noEmit": true, "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["tests"]
}
