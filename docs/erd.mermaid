erDiagram
  %% Generated by `pnpm db:erd` from the live schema. Do not edit by hand.
  %% Every operational table also has branch_id -> branches (composite FKs keep parent and child in the same branch).
  audit_log {
    uuid id PK
    uuid branch_id FK
    uuid actor_user_id FK
  }
  barcodes {
    uuid id PK
    uuid branch_id FK
    uuid order_id FK
    uuid order_item_id FK
    text code
  }
  branch_counters {
    uuid branch_id PK,FK
    text counter PK
  }
  branches {
    uuid id PK
    text code
  }
  client_mutations {
    uuid id PK
    uuid branch_id FK
    uuid user_id FK
  }
  company_invoices {
    uuid id PK
    uuid branch_id FK
    uuid customer_id FK
    numeric total
    uuid issued_by FK
  }
  company_price_overrides {
    uuid id PK
    uuid branch_id FK
    uuid customer_id FK
    uuid product_id FK
  }
  customer_accounts {
    uuid id PK
    uuid branch_id FK
    uuid customer_id FK
  }
  customer_sessions {
    uuid id PK
    uuid account_id FK
  }
  customer_tokens {
    uuid id PK
    uuid account_id FK
  }
  customers {
    uuid id PK
    uuid branch_id FK
  }
  gallery_item_media {
    uuid gallery_item_id PK,FK
    uuid media_id PK,FK
    uuid branch_id FK
  }
  gallery_items {
    uuid id PK
    uuid branch_id FK
    uuid service_id FK
    text status
    uuid updated_by FK
  }
  inventory_items {
    uuid id PK
    uuid branch_id FK
    text sku
  }
  login_failures {
    text identifier PK
  }
  media {
    uuid id PK
    uuid branch_id FK
    uuid created_by FK
  }
  notification_logs {
    uuid id PK
    uuid branch_id FK
    uuid order_id FK
    uuid customer_id FK
    uuid template_id FK
    text template_key
    text channel
    text status
    uuid created_by FK
  }
  notification_templates {
    uuid id PK
    uuid branch_id FK
    text template_key
    text channel
  }
  order_files {
    uuid id PK
    uuid branch_id FK
    uuid order_id FK
    uuid order_item_id FK
    uuid uploaded_by_account FK
    uuid uploaded_by_user FK
  }
  order_items {
    uuid id PK
    uuid branch_id FK
    uuid order_id FK
    uuid product_id FK
  }
  order_status_history {
    uuid id PK
    uuid branch_id FK
    uuid order_id FK
    uuid barcode_id FK
    uuid changed_by FK
  }
  orders {
    uuid id PK
    uuid branch_id FK
    bigint order_number
    text public_code
    uuid customer_id FK
    text status
    numeric total
    uuid created_by FK
    uuid company_invoice_id FK
  }
  product_materials {
    uuid id PK
    uuid branch_id FK
    uuid product_id FK
    uuid item_id FK
  }
  products {
    uuid id PK
    uuid branch_id FK
    text sku
    uuid cover_media_id FK
    uuid service_id FK
  }
  proof_responses {
    uuid id PK
    uuid branch_id FK
    uuid proof_id FK
  }
  proofs {
    uuid id PK
    uuid branch_id FK
    uuid order_id FK
    text public_code
    text status
    uuid uploaded_by FK
  }
  push_subscriptions {
    uuid id PK
    uuid branch_id FK
    uuid user_id FK
  }
  quote_items {
    uuid id PK
    uuid branch_id FK
    uuid quote_id FK
  }
  quotes {
    uuid id PK
    uuid branch_id FK
    text public_code
    uuid customer_id FK
    text status
    numeric total
    uuid order_id FK
    uuid created_by FK
  }
  refresh_tokens {
    uuid id PK
    uuid user_id FK
    uuid replaced_by FK
  }
  roles {
    uuid id PK
    text key
  }
  services {
    uuid id PK
    uuid branch_id FK
    uuid cover_media_id FK
    text status
    uuid updated_by FK
  }
  site_settings {
    uuid branch_id PK,FK
    uuid hero_media_id FK
    uuid updated_by FK
  }
  stock_movements {
    uuid id PK
    uuid branch_id FK
    uuid item_id FK
    text movement_type
    uuid order_id FK
    uuid order_item_id FK
    uuid created_by FK
    uuid source_event_id FK
  }
  transactions {
    uuid id PK
    uuid branch_id FK
    uuid order_id FK
    uuid customer_id FK
    text txn_type
    text method
    text status
    uuid collected_by FK
    uuid settled_by FK
    uuid created_by FK
  }
  users {
    uuid id PK
    uuid branch_id FK
    uuid role_id FK
  }
  users |o--o{ audit_log : "actor_user_id"
  order_items |o--o{ barcodes : "order_item_id"
  orders ||--o{ barcodes : "order_id"
  users |o--o{ client_mutations : "user_id"
  customers ||--o{ company_invoices : "customer_id"
