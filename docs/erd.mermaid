  order_items |o--o{ stock_movements : "order_item_id"
  order_status_history |o--o{ stock_movements : "source_event_id"
  customers |o--o{ transactions : "customer_id"
  orders |o--o{ transactions : "order_id"
  branches ||--o{ users : "branch_id"
