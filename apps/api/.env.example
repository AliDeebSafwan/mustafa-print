NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (matches docker-compose.yml at the repo root)
DATABASE_URL=postgres://mustafa:CHANGE_ME@localhost:5432/mustafa
# Behind Cloudflare + reverse proxy on the VPS keep 1; set 0 when the API is exposed directly.
TRUST_PROXY=1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5176
# Public URL of the customer website (used in tracking links inside messages)
PUBLIC_WEB_URL=http://localhost:3000

# Auth. Required. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Secure cookies are on by default in production; only set false for plain-http local testing.
# COOKIE_SECURE=false
# Rows changed in the last N seconds are held back from sync pulls (protects against slow commits).
SYNC_PULL_LAG_SECONDS=5

# ---- Seed (pnpm db:seed) ----
DEFAULT_BRANCH_CODE=MAIN
SEED_BRANCH_TIMEZONE=UTC
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Messaging worker ----
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=10

# WhatsApp: console (logs only) | cloud (official WhatsApp Business Cloud API)
WHATSAPP_PROVIDER=console
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Use a version that is currently supported by Meta (check the Graph API changelog).
WHATSAPP_API_VERSION=v23.0

# Email: console | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Mustafa Print <no-reply@example.com>"

# SMS: no provider chosen yet -> none (messages to SMS-only customers fail visibly) | console
SMS_PROVIDER=none

# Uploaded pictures (the website's services, showroom and products). Back this directory up with the database.
MEDIA_DIR=./storage/media
# Optional: lets content edits appear on the website at once instead of within a minute.
# WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# WEB_REVALIDATE_SECRET=   # same value in apps/web/.env; generate with: openssl rand -base64 32
